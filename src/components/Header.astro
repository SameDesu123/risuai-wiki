---
// Adds a button before the site title that shows or hides the left sidebar on
// screens where Starlight would otherwise always show it (50rem and wider).
// Narrow screens keep Starlight's own menu button.
//
// - Below `wideQuery` (tablet widths) the sidebar is hidden and the button opens
//   it as an overlay above the text. Clicking outside it, pressing Escape, or
//   going to another page closes it. This state is not saved.
// - At `wideQuery` and wider the sidebar sits beside the text. The button
//   collapses it, and the choice is saved in localStorage.
//
// The CSS for both modes is in src/styles/custom.css; keep its breakpoints in sync.
import Default from '@astrojs/starlight/components/Header.astro';

const { hasSidebar } = Astro.locals.starlightRoute;
const label = Astro.locals.t('wiki.toggleSidebar');
const wideQuery = '(min-width: 75rem)';
---

<div class="wiki-header">
	{
		hasSidebar && (
			<>
				<script is:inline>
					// Runs before the sidebar is parsed, so a collapsed sidebar never flashes open.
					try {
						if (localStorage.getItem('wiki:sidebar-collapsed') === '1') {
							document.documentElement.setAttribute('data-sidebar-collapsed', '');
						}
					} catch {}
				</script>
				<button
					type="button"
					class="wiki-sidebar-toggle sl-hidden md:sl-flex print:hidden"
					aria-controls="starlight__sidebar"
					aria-expanded="false"
					aria-label={label}
					title={label}
					data-wide-query={wideQuery}
				>
					<svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<rect x="3" y="4" width="18" height="16" rx="2" />
						<path d="M9 4v16" />
					</svg>
				</button>
			</>
		)
	}
	<div class="wiki-header-default"><Default /></div>
</div>

<script>
	const root = document.documentElement;
	const COLLAPSED = 'data-sidebar-collapsed';
	const OVERLAY_OPEN = 'data-sidebar-overlay-open';

	document.querySelectorAll<HTMLButtonElement>('.wiki-sidebar-toggle').forEach((button) => {
		const wide = matchMedia(button.dataset.wideQuery!);
		const pane = document.getElementById('starlight__sidebar');

		const sync = () => {
			const open = wide.matches ? !root.hasAttribute(COLLAPSED) : root.hasAttribute(OVERLAY_OPEN);
			button.setAttribute('aria-expanded', String(open));
		};
		const closeOverlay = () => {
			root.removeAttribute(OVERLAY_OPEN);
			sync();
		};

		button.addEventListener('click', () => {
			if (wide.matches) {
				const collapsed = root.toggleAttribute(COLLAPSED);
				try {
					localStorage.setItem('wiki:sidebar-collapsed', collapsed ? '1' : '0');
				} catch {}
			} else {
				root.toggleAttribute(OVERLAY_OPEN);
			}
			sync();
		});

		// Close the overlay on a click outside it or on Escape.
		document.addEventListener('click', (event) => {
			if (!root.hasAttribute(OVERLAY_OPEN)) return;
			const target = event.target as Node;
			if (button.contains(target) || pane?.contains(target)) return;
			closeOverlay();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape' || !root.hasAttribute(OVERLAY_OPEN)) return;
			closeOverlay();
			button.focus();
		});

		wide.addEventListener('change', closeOverlay);
		sync();
	});
</script>

<style>
	.wiki-header {
		display: flex;
		align-items: center;
		gap: var(--sl-nav-gap);
		height: 100%;
	}

	.wiki-header-default {
		flex: 1;
		min-width: 0;
		height: 100%;
	}

	.wiki-sidebar-toggle {
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		width: 2.25rem;
		height: 2.25rem;
		padding: 0;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}

	.wiki-sidebar-toggle:hover,
	.wiki-sidebar-toggle[aria-expanded='true'] {
		color: var(--sl-color-white);
	}

	.wiki-sidebar-toggle:hover {
		background-color: var(--sl-color-gray-6);
	}
</style>
