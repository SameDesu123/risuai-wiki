---
// Adds the sidebar button (SidebarToggle.astro) before the site title.
// On pages with a table of contents, Starlight shows an "On this page" bar below 72rem, and the
// button sits in that bar instead (MobileTableOfContents.astro), so this copy only appears from 72rem.
import Default from '@astrojs/starlight/components/Header.astro';
import SidebarToggle from './SidebarToggle.astro';

const { hasSidebar, toc } = Astro.locals.starlightRoute;
---

<div class="wiki-header">
	{
		hasSidebar && (
			<>
				<script is:inline>
					// Runs before the sidebar is parsed, so a collapsed sidebar never flashes open.
					try {
						if (localStorage.getItem('wiki:sidebar-collapsed') === '1') {
							document.documentElement.setAttribute('data-sidebar-collapsed', '');
						}
					} catch {}
				</script>
				<SidebarToggle placement="header" class={toc ? 'sl-hidden lg:sl-flex' : 'sl-hidden md:sl-flex'} />
			</>
		)
	}
	<div class="wiki-header-default"><Default /></div>
</div>

<style>
	.wiki-header {
		display: flex;
		align-items: center;
		gap: var(--sl-nav-gap);
		height: 100%;
	}

	.wiki-header-default {
		flex: 1;
		min-width: 0;
		height: 100%;
	}
</style>
