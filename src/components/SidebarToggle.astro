---
// The button that shows or hides the left sidebar on screens where Starlight would otherwise
// always show it (50rem and wider). Narrow screens keep Starlight's own menu button.
//
// It is placed in two spots, and CSS shows one at a time:
// - `placement="toc"`: at the start of the "On this page" bar that Starlight shows below 72rem
//   (see MobileTableOfContents.astro). Used from 50rem to 72rem on pages with that bar.
// - `placement="header"`: before the site title (see Header.astro). Used everywhere else.
// The script below drives every copy, so they always agree.
//
// - Below `wideQuery` (tablet widths) the sidebar is hidden and the button opens it as an
//   overlay above the text. Clicking outside it, pressing Escape, tabbing out of it, or going to
//   another page closes it. This state is not saved.
// - At `wideQuery` and wider the sidebar sits beside the text. The button collapses it, and the
//   choice is saved in localStorage.
//
// The CSS for both modes is in src/styles/custom.css; keep its breakpoints in sync.

interface Props {
	placement: 'header' | 'toc';
	/** Starlight display utilities that decide at which widths this copy is shown. */
	class: string;
}

const { placement, class: className } = Astro.props;
const label = Astro.locals.t('wiki.toggleSidebar');
const wideQuery = '(min-width: 75rem)';
---

<button
	type="button"
	class:list={['wiki-sidebar-toggle', 'print:hidden', className]}
	data-placement={placement}
	aria-controls="starlight__sidebar"
	aria-expanded="false"
	aria-label={label}
	title={label}
	data-wide-query={wideQuery}
>
	<svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
		<rect x="3" y="4" width="18" height="16" rx="2"></rect>
		<path d="M9 4v16"></path>
	</svg>
</button>

<script>
	const root = document.documentElement;
	const COLLAPSED = 'data-sidebar-collapsed';
	const OVERLAY_OPEN = 'data-sidebar-overlay-open';

	const buttons = [...document.querySelectorAll<HTMLButtonElement>('.wiki-sidebar-toggle')];
	const pane = document.getElementById('starlight__sidebar');

	if (buttons.length > 0) {
		const wide = matchMedia(buttons[0]!.dataset.wideQuery!);
		// The copy that opened the overlay, so Escape can return focus to it.
		let opener: HTMLButtonElement | undefined;

		const isToggle = (node: Node | null) => node !== null && buttons.some((b) => b.contains(node));

		const sync = () => {
			const open = wide.matches ? !root.hasAttribute(COLLAPSED) : root.hasAttribute(OVERLAY_OPEN);
			for (const b of buttons) b.setAttribute('aria-expanded', String(open));
		};

		const closeOverlay = ({ returnFocus = false } = {}) => {
			if (!root.hasAttribute(OVERLAY_OPEN)) return;
			root.removeAttribute(OVERLAY_OPEN);
			sync();
			if (returnFocus) opener?.focus();
		};

		for (const button of buttons) {
			button.addEventListener('click', () => {
				if (wide.matches) {
					const collapsed = root.toggleAttribute(COLLAPSED);
					try {
						localStorage.setItem('wiki:sidebar-collapsed', collapsed ? '1' : '0');
					} catch {}
					sync();
					return;
				}
				if (root.hasAttribute(OVERLAY_OPEN)) {
					closeOverlay();
					return;
				}
				root.setAttribute(OVERLAY_OPEN, '');
				opener = button;
				sync();
				// The sidebar comes before the "On this page" bar in the page, so Tab from that copy
				// would skip it. Start keyboard users inside it, at the current page.
				const start =
					pane?.querySelector<HTMLElement>('a[aria-current="page"]') ?? pane?.querySelector<HTMLElement>('a');
				start?.focus();
			});
		}

		// Close the overlay on a click outside it, on Escape, or when Tab leaves it.
		document.addEventListener('click', (event) => {
			if (!root.hasAttribute(OVERLAY_OPEN)) return;
			const target = event.target as Node;
			if (isToggle(target) || pane?.contains(target)) return;
			closeOverlay();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape') closeOverlay({ returnFocus: true });
		});
		pane?.addEventListener('focusout', (event) => {
			const next = event.relatedTarget as Node | null;
			if (next && !pane.contains(next) && !isToggle(next)) closeOverlay();
		});

		wide.addEventListener('change', () => closeOverlay());
		sync();
	}
</script>

<style>
	.wiki-sidebar-toggle {
		flex-shrink: 0;
		align-items: center;
		justify-content: center;
		padding: 0;
		border: 1px solid var(--sl-color-hairline-shade);
		border-radius: 0.5rem;
		background: transparent;
		color: var(--sl-color-gray-2);
		cursor: pointer;
	}

	.wiki-sidebar-toggle:hover,
	.wiki-sidebar-toggle[aria-expanded='true'] {
		color: var(--sl-color-white);
	}

	[data-placement='header'] {
		width: 2.25rem;
		height: 2.25rem;
	}

	[data-placement='header']:hover {
		background-color: var(--sl-color-gray-6);
	}

	[data-placement='header'] svg {
		width: 1.25rem;
		height: 1.25rem;
	}

	/* Starlight's bar is fixed below the header, so this copy is fixed over the bar's start, sized and
	   styled like the bar's "On this page" button (2.125rem tall: 1rem icon, 0.5rem padding, 1px
	   border). custom.css moves the bar's own content over to make room. It sits above the dimmed
	   page while the overlay is open, so it can close the overlay again. */
	[data-placement='toc'] {
		position: fixed;
		z-index: calc(var(--sl-z-index-menu) + 3);
		inset-block-start: calc(var(--sl-nav-height) + (var(--sl-mobile-toc-height) - 1px - 2.125rem) / 2);
		inset-inline-start: 1rem;
		width: 2.125rem;
		height: 2.125rem;
		border-color: var(--sl-color-gray-5);
		background-color: var(--sl-color-black);
	}

	[data-placement='toc']:hover {
		border-color: var(--sl-color-gray-2);
	}

	[data-placement='toc'][aria-expanded='true'] {
		border-color: var(--sl-color-accent);
	}

	[data-placement='toc'] svg {
		width: 1.125rem;
		height: 1.125rem;
	}
</style>
